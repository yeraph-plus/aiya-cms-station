AIYA_SITE_URL=http://localhost:4321
# The front site's own origin — canonical, sitemap, cookie Secure, and the
# aiya_session Domain attribute (the registrable root is derived here, e.g.
# https://www.site.name/ scopes the session cookie to site.name so sibling
# subdomain apps share the login state; every subdomain must be first-party,
# the cookie carries the visitor's bearer). localhost/IP keeps the cookie
# host-only.
# Port coupling: npm run dev serves on 4399, npm start (built server) on
# 4321 — one value serves both, so while developing on 4399 origin-bearing
# output keeps pointing at the port configured here (harmless locally;
# change the port here when the exact origin matters in dev).
# Content reads and visitor auth (identity) both live here. There is no
# service account: content reads are anonymous (no admin/preview capability
# on this frontend). With no reachable backend the site serves its gate.
# The WP host only (origin) — the frozen /wp-json/aiya/core/v1/ root is
# appended by the app; a full-path value keeps working too.
AIYA_WP_API_URL=http://localhost:8000
AIYA_API_TIMEOUT_MS=8000
# HTTP allowed ONLY on loopback, with this development opt-in.
AIYA_ALLOW_LOCAL_HTTP=false
# Proxy bridge to the backend: the shared secret authenticates this server
# so WP trusts the X-Forwarded-For visitor address we forward (rate limiting,
# guest dedup and the comment IP bind to the real client). Must equal the
# AIYA_PROXY_SECRET constant in wp-config.php; unset = no bridge headers.
AIYA_PROXY_SECRET=
# Request header this deployment trusts for the visitor address. Behind an
# edge proxy this MUST be set — it has to name a header the edge *overwrites*
# (nginx `proxy_set_header X-Real-IP $remote_addr`), never X-Forwarded-For:
# that list is appended by `$proxy_add_x_forwarded_for`, so its first entry is
# whatever the client sent. The front refuses an address that came from
# X-Forwarded-For (see lib/visitor-ip.ts), which without this header collapses
# every visitor onto the proxy's own address: rate limiting still works, but as
# a single shared bucket, and a ban would hit everyone.
# Empty = direct deployment, the socket address stands.
AIYA_CLIENT_IP_HEADER=X-Real-IP
