AIYA_SITE_URL=http://localhost:4321
# The front site's own origin — canonical, sitemap, cookie Secure, and the
# aiya_session Domain attribute (the registrable root is derived here, e.g.
# https://www.site.name/ scopes the session cookie to site.name so sibling
# subdomain apps share the login state; every subdomain must be first-party,
# the cookie carries the visitor's bearer). localhost/IP keeps the cookie
# host-only.
# Content reads and visitor auth (identity) both live here. There is no
# service account: content reads are anonymous (no admin/preview capability
# on this frontend). With no reachable backend the site serves its gate.
AIYA_WP_API_URL=http://localhost:8000/wp-json/aiya/core/v1/
AIYA_API_TIMEOUT_MS=8000
# HTTP allowed ONLY on loopback, with this development opt-in.
AIYA_ALLOW_LOCAL_HTTP=false
# Proxy bridge to the backend: the shared secret authenticates this server
# so WP trusts the X-Forwarded-For visitor address we forward (rate limiting,
# guest dedup and the comment IP bind to the real client). Must equal the
# AIYA_PROXY_SECRET constant in wp-config.php; unset = no bridge headers.
AIYA_PROXY_SECRET=
# Optional: request header this deployment trusts for the visitor address
# (e.g. X-Real-IP, CF-Connecting-IP) when sitting behind an edge proxy.
# Empty = the socket address stands.
#AIYA_CLIENT_IP_HEADER=
# Optional: Domain attribute for the aiya_session cookie (e.g. site.name).
# Set it when sibling apps on subdomains of one domain must share the login
# state — the browser then sends the session cookie to every subdomain.
# Every subdomain under it must be first-party (the cookie carries the
# visitor's bearer token); unset = the cookie stays on the front-end host.
# A malformed value or one outside the site's own hostname fails closed.
#AIYA_SESSION_COOKIE_DOMAIN=
