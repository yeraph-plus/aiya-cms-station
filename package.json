{
  "name": "front-station",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run test && npm run format:check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "6.0.5",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "astro": "7.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "entities": "^8.1.0",
    "lucide-react": "^1.43.0",
    "lucide-static": "^1.44.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tldts": "^7.4.16",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "shadcn": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
