{
  "name": "front-station",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 4399 --strictPort",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node scripts/start-guard.mjs && node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run test && npm run format:check && npm run fonts:check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:fetch": "node scripts/fonts/fetch.mjs",
    "fonts:snapshot": "node scripts/fonts/snapshot-ranges.mjs",
    "fonts:build": "node scripts/fonts/build.mjs",
    "fonts:check": "node scripts/fonts/check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "6.0.5",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "entities": "^8.1.0",
    "lucide-react": "^1.61.0",
    "lucide-static": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tldts": "^7.4.19",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "fontkit": "^2.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "shadcn": "^4.22.1",
    "subset-font": "^2.9.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
