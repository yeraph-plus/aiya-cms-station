---
/**
 * P1 卡片配方（真实 PostLoop 实装，不是仿写）：灰纸白卡、6px 圆角、无静止描边、
 * 16:10 媒体 + 悬停 1.04 缩放、20px 卡间距、12px 表格式元信息。
 *
 * 这一块存在的理由：站点的内容接口不可用时首页是空壳，没法用肉眼对比卡片改动；
 * 这里用静态数据渲染同一个 `PostLoop` 岛，所见即站点首页的卡片。
 */
import PostLoop from '@/components/islands/feed/PostLoop';
import type { PostSummary } from '@/lib/core/contracts';
import type { Locale } from '@/lib/i18n/locale';

const locale: Locale = 'zh_CN';

const stories: Array<[string, string, string, number, number]> = [
  ['story-1.jpg', '梵高躁动的头脑，如何描绘物理学中最复杂的概念之一？', 'style hunter', 1284, 32],
  ['story-2.jpg', '用一张照片，记住整个八月的湿度', 'photography', 986, 12],
  ['story-3.jpg', '打字机、旧胶片与第三种沉默', 'culture', 742, 8],
  ['story-4.jpg', '山脊线以下的十二公里', 'travel', 631, 5],
  ['story-5.jpg', '给未来的自己留一页空白', 'essay', 512, 21],
  ['story-6.jpg', '所谓风格，是重复了足够多次的选择', 'fashion', 433, 9],
  ['cover-1.jpg', '在美术馆的第三个展厅，时间被重新调慢', 'art', 388, 3],
  ['cover-2.jpg', '夜班司机的歌单，一共二十六首', 'music', 297, 17],
];

const items = stories.map(([file, title, category, views, comments], index) => ({
  id: index + 1,
  type: 'post',
  slug: `demo-${index + 1}`,
  title,
  excerpt: '挑那只像日落一样的黄桃，红色、橙色与粉色的皮，用牙齿剥开。把味觉折进未成熟的夏天。',
  badges: [],
  categories: [{ id: index + 1, slug: category, name: category }],
  author: { id: 1, slug: 'editor', name: 'Katy Liu', avatar: null },
  metrics: { views, likes: views % 37, comments, ratingScore: null, ratingCount: null },
  thumbnail: { url: `/assets/${file}`, alt: '', width: 320, height: 200 },
})) as unknown as PostSummary[];
---

<div class="mx-auto w-full max-w-shell px-4 pb-16 lg:px-12">
  <h3 class="ed-rule relative mb-2 inline-block pb-3 text-lg font-bold">
    卡片配方（真实 PostLoop 实装）
  </h3>
  <p class="mb-8 max-w-2xl text-sm text-muted-foreground">
    灰纸白卡 · 6px 圆角 · 无静止描边（悬停抬一档阴影，不出描边）· 16:10 媒体 + 悬停 1.04 缩放 · 20px
    卡间距 · 标题 500 字重、悬停转主题色 · 12px 表格式元信息。 悬停任意卡片即可对比。
  </p>

  <PostLoop
    client:visible
    endpoint="/api/feed/posts/"
    items={items}
    pagination={{ page: 1, totalPages: 1, hasNext: false, hasPrevious: false }}
    page={1}
    perPage={8}
    query={{}}
    route={{ index: '/', pagePattern: '/page/{page}/' }}
    heading="最新文章"
    more={{ href: '#', label: '查看全部' }}
    showViewToggle
    defaultView="grid"
    stickyView={false}
    emptyText="暂无内容"
    errorText="内容接口不可用"
    locale={locale}
  />
</div>
