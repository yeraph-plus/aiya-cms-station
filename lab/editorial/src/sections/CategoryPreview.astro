---
/**
 * 02 · category.html 复刻：360px 静默封面带（原页面此处没有任何文字）+「不要错过」
 * 面板（胶囊标签 + more 下拉）+ 九张卡（图片 / 纯文本 / 背景图交替）+ 加载更多 + 侧栏。
 */
import {
  ArchiveHero,
  PillButton,
  PromoCard,
  Rail,
  RailItem,
  RailSection,
  SectionHeader,
  StoryGrid,
} from '@/components/editorial';
import { categoryStories, moreMenu, railTop, sectionTags } from '../data';
---

<ArchiveHero image={{ url: '/assets/hero-3.jpg', alt: '分类封面' }} />

<div class="mx-auto w-full max-w-shell px-4 py-16 lg:px-12">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
    <div class="min-w-0">
      <SectionHeader title="不要错过" tags={sectionTags} more={moreMenu} />
      <StoryGrid stories={categoryStories} columns={3} className="mt-8" />
      <div class="mt-20 flex justify-center">
        <PillButton>加载更多</PillButton>
      </div>
    </div>

    <Rail label="分类侧栏" className="h-fit lg:sticky lg:top-6">
      <RailSection title="头条" action={{ label: 'top' }}>
        {railTop.slice(0, 3).map((story) => <RailItem story={story} />)}
      </RailSection>

      <PromoCard
        href="#"
        title="深色广告位"
        eyebrow="-15%"
        image={{ url: '/assets/promo-2.jpg', alt: '广告示意' }}
      />
    </Rail>
  </div>
</div>
