---
import TermArchive from '@/components/content/TermArchive.astro';
import { loadCategoryHub } from '@/lib/archive';

const slug = Astro.params.slug ?? '';
const n = Number(Astro.params.n);
// Page 1 lives at the hub entry; anything non-numeric 404s.
if (!Number.isInteger(n) || n < 2) {
  return Astro.redirect(`/categories/${slug}/`);
}
const view = await loadCategoryHub(Astro, {
  slug,
  page: n,
});
---

<TermArchive view={view} />
