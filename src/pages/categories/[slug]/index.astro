---
/**
 * /categories/[slug]/ — the unified category page. No shell of its own:
 * TermArchive carries the layout, and the reusable CategoryCard island is
 * slotted in as the page header (bottom margin separates it from the loop
 * toolbar). Unknown slugs arrive as framed 404 views.
 */
import TermArchive from '@/components/content/TermArchive.astro';
import { CategoryCard } from '@/components/islands/CategoryCards';
import { loadCategoryHub } from '@/lib/archive';
import { rewriteMediaUrl } from '@/lib/media';
import { t } from '@/lib/i18n';

const slug = Astro.params.slug ?? '';
const view = await loadCategoryHub(Astro, { slug, page: 1 });
if (!view.page.ok) Astro.response.status = view.page.error.status;
const copy = t(view.page.locale);
const typeLabel = {
  posts: copy.posts.title,
  resources: copy.resources.title,
  pages: copy.pages.title,
}[view.type];
---

<TermArchive view={view}>
  {
    view.page.ok && (
      <div class="mb-5">
        <CategoryCard
          client:idle
          card={{
            slug,
            type: view.type,
            name: view.name,
            description: view.description,
            cover: view.cover
              ? { ...view.cover, url: rewriteMediaUrl(view.cover.url) }
              : null,
            count: view.count,
            countText: copy.categories.countLabel(view.count),
            typeLabel,
            icon: view.icon,
          }}
          defaultCover={
            view.page.site.defaults.thumb
              ? {
                  ...view.page.site.defaults.thumb,
                  url: rewriteMediaUrl(view.page.site.defaults.thumb.url),
                }
              : null
          }
        />
      </div>
    )
  }
</TermArchive>
