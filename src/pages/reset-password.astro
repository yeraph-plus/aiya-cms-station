---
/**
 * Password reset: the request form without query args; the reset form when
 * the emailed link lands back with ?login=&key=. Always noindex.
 */
import AppShell from '@/components/layout/AppShell.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import ResetPasswordPanel from '@/components/islands/user-center/ResetPasswordPanel';
import { t } from '@/lib/i18n';
import { loadPage } from '@/lib/page.server';
import { setCrumbs } from '@/lib/breadcrumbs';

const login = (Astro.url.searchParams.get('login') ?? '').slice(0, 100) || null;
const key = (Astro.url.searchParams.get('key') ?? '').slice(0, 200) || null;

const page = await loadPage(async () => undefined, Astro.cookies);
const copy = t(page.locale);
if (page.ok) setCrumbs(Astro.locals, page.locale, [{ label: copy.settings.resetTitle }]);
---

<AppShell
  page={page}
  title={copy.settings.resetTitle}
  description={copy.settings.resetRequestDesc}
  canonicalPath="/reset-password/"
  noindex
>
  <h1 class="sr-only">{copy.settings.resetTitle}</h1>
  <div class="mx-auto max-w-md">
    {
      /* `key` is React-reserved (createElement swallows it, so the island
        would never see the value) — the reset token travels as `resetKey`. */
    }
    <ResetPasswordPanel
      client:load
      login={login}
      resetKey={key}
      locale={page.locale}
      copy={{
        resetTitle: copy.settings.resetTitle,
        resetRequestDesc: copy.settings.resetRequestDesc,
        sendResetLink: copy.settings.sendResetLink,
        resetSent: copy.settings.resetSent,
        resetInvalid: copy.settings.resetInvalid,
        resetDone: copy.settings.resetDone,
        newPasswordLabel: copy.settings.newPasswordLabel,
        passwordConfirmLabel: copy.shell.passwordConfirmLabel,
        save: copy.settings.save,
        authFailed: copy.shell.authFailed,
      }}
    />
  </div>
</AppShell>
