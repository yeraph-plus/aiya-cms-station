---
/** Resource list pagination: /resources/page/[n]/ (n ≥ 2); filters ride along. */
import AppShell from '@/components/layout/AppShell.astro';
import PageState from '@/components/layout/PageState.astro';
import PostLoop from '@/components/islands/feed/PostLoop';
import { t } from '@/lib/i18n';
import { loadFeedPage } from '@/lib/feed-page';

const n = Number(Astro.params.n);
// Page 1 and non-numeric shapes live at /resources/ — permanent
// normalization (308), and the active filter query rides along.
if (!Number.isInteger(n) || n < 2) {
  return Astro.redirect(`/resources/${Astro.url.search}`, 308);
}

const view = await loadFeedPage(
  'resources',
  Astro.response,
  Astro.url,
  Astro.cookies,
  Astro.locals,
  n,
);
const copy = t(view.page.locale);
---

<AppShell
  page={view.page}
  title={view.listTitle}
  description={copy.resources.description}
  canonicalPath={view.canonical}
  noindex={view.filtered || view.overRange}
>
  {
    view.page.ok &&
      (view.overRange ? (
        <PageState
          image={view.page.site.defaults.emptyImage}
          error
          title={copy.state.notFoundTitle}
          message={copy.state.notFoundMessage}
          retry="/resources/"
          retryLabel={copy.common.retry}
        />
      ) : (
        <>
          <h1 class="sr-only">{view.listTitle}</h1>
          <PostLoop
            autoLoad
            client:load
            endpoint="/api/feed/resources/"
            items={view.page.value.items}
            pagination={view.page.value.pagination}
            page={n}
            query={{ ...view.filters }}
            route={{
              index: '/resources/',
              pagePattern: '/resources/page/{page}/',
              carry: ['q', 'category', 'tag', 'sort'],
            }}
            emptyText={copy.resources.listEmpty}
            errorText={copy.state.backendMessage}
            locale={view.page.locale}
          />
        </>
      ))
  }
</AppShell>
