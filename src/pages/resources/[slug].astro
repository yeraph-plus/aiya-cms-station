---
import AppShell from '@/components/layout/AppShell.astro';
import ResourceDetail from '@/components/islands/detail/ResourceDetail';
import { t } from '@/lib/i18n';
import { loadPage } from '@/lib/page.server';
import { setCrumbs } from '@/lib/breadcrumbs';
import { detailSlug, loadDetail } from '@/lib/detail';
import { detailSeo } from '@/lib/seo';

const slug = detailSlug(Astro.params.slug);
if (slug === '') {
  return Astro.redirect(`/resources/${Astro.url.search}`, 308);
}
const page = await loadPage(
  (client, site) => loadDetail('resource', client, site, slug),
  Astro.cookies,
  Astro.locals.visitorIp,
);
if (!page.ok) Astro.response.status = page.error.status;
const copy = t(page.locale);
const post = page.ok ? page.value.post : null;
if (page.ok && post) {
  setCrumbs(Astro.locals, page.locale, [
    { label: copy.resources.title, href: '/resources/' },
    { label: post.title },
  ]);
}
const seo = detailSeo(
  post,
  page.site,
  page.origin,
  copy.state.notFoundTitle,
  copy.state.notFoundMessage,
);
---

<AppShell
  page={page}
  title={seo.title}
  description={seo.description}
  canonicalPath={`/resources/${Astro.params.slug}/`}
  noindex={seo.noindex}
  image={seo.coverUrl}
  ogType="article"
  jsonLd={seo.jsonLd}
>
  {
    page.ok && post && (
      <ResourceDetail
        client:load
        post={post}
        termIcons={page.value.termIcons}
        comments={page.value.comments}
        commentsPagination={
          page.value.commentsPagination ?? { page: 1, totalPages: 0, hasNext: false }
        }
        related={page.value.related}
        downloads={page.value.downloads}
        threads={page.value.threads}
        threadsTotal={page.value.threadsTotal}
        boards={page.value.boards}
        authorBio={page.value.authorBio}
        isSelf={Boolean(page.user && page.user.id === page.value.authorId)}
        settings={page.site.comments}
        loggedIn={Boolean(page.user)}
        locale={page.locale}
        timezone={page.site.timezone}
        commentsWindow={page.value.commentsWindow}
      />
    )
  }
</AppShell>
