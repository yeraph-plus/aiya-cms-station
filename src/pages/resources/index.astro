---
/**
 * Resource list: PostLoop with inline resource_category chips. `?q=` and the
 * category filter stay SSR query params (noindex when filtered); the loop
 * island serves subsequent states from the same-origin JSON feed.
 */
import AppShell from '@/components/layout/AppShell.astro';
import PostLoop from '@/components/islands/feed/PostLoop';
import { cloakPostSummaryMedia } from '@/lib/media';
import { iconInner } from '@/lib/icons';
import { t } from '@/lib/i18n';
import { loadPage } from '@/lib/page.server';
import { setCrumbs } from '@/lib/breadcrumbs';
import { canonicalQuery, chipHref, isFiltered, parseListFilters } from '@/lib/filters';

// Same filter contract as /resources/page/[n]/ — q / category / tag / sort;
// see the posts routes for why both halves must read the identical keys.
const filters = parseListFilters(Astro.url, true);
const { q, category, tag, sort } = filters;
const filtered = isFiltered(filters);

const page = await loadPage(
  async (client) => {
    const [list, terms] = await Promise.all([
      client.resources({ q, category, tag, sort }),
      client.terms('all', 'resource'),
    ]);
    return {
      resources: list.data,
      pagination: list.meta.pagination,
      categories: terms.data.filter((term) => term.taxonomy === 'category'),
      tags: terms.data.filter((term) => term.taxonomy === 'tag'),
    };
  },
  Astro.cookies,
  Astro.locals.visitorIp,
);
if (!page.ok) Astro.response.status = page.error.status;
const copy = t(page.locale);
if (page.ok) setCrumbs(Astro.locals, page.locale, [{ label: copy.resources.title }]);
const listTitle = q !== '' ? copy.resources.searchTitle(q) : copy.resources.title;
// Category chips filter this same list, so each chip href is the query state
// the island itself produces — the path route they used to point at
// (/resources/category/{slug}/) no longer exists. The crawlable category
// archive is /categories/{slug}/, linked from the category index.
const canonicalPath = filtered ? `/resources/?${canonicalQuery(filters)}` : '/resources/';
// The five tag-style vocabularies become the filter panel's groups (grouped
// in first-seen /terms order; unknown vocabulary codes fall back to the code).
const vocabLabels: Record<string, string> = {
  resource_original: copy.resources.vocabOriginal,
  resource_character: copy.resources.vocabCharacter,
  resource_author: copy.resources.vocabAuthor,
  resource_content: copy.resources.vocabContent,
  resource_other: copy.resources.vocabOther,
};
const tagGroups: {
  key: string;
  label: string;
  items: { slug: string; name: string; icon: string | null }[];
}[] = [];
if (page.ok) {
  const byVocab = new Map<string, { slug: string; name: string; icon: string | null }[]>();
  for (const term of page.value.tags) {
    if (!byVocab.has(term.vocabulary)) byVocab.set(term.vocabulary, []);
    byVocab.get(term.vocabulary)!.push({
      slug: term.slug,
      name: term.name,
      icon: term.icon ? iconInner(term.icon) : null,
    });
  }
  for (const [key, items] of byVocab) {
    tagGroups.push({ key, label: vocabLabels[key] ?? key, items });
  }
}
---

<AppShell
  page={page}
  title={listTitle}
  description={copy.resources.description}
  canonicalPath={canonicalPath}
  noindex={filtered || !page.ok}
>
  <h1 class="sr-only">{listTitle}</h1>
  {
    page.ok && (
      <>
        <PostLoop
          autoLoad
          client:load
          chips={[
            {
              slug: '',
              name: copy.resources.all,
              href: chipHref('/resources/', filters, ''),
            },
            ...page.value.categories.map((term) => ({
              slug: term.slug,
              name: term.name,
              count: term.count,
              icon: term.icon ? iconInner(term.icon) : null,
              href: chipHref('/resources/', filters, term.slug),
            })),
          ]}
          filterAriaLabel={copy.resources.category}
          tagGroups={tagGroups}
          endpoint="/api/feed/resources/"
          items={page.value.resources.map(cloakPostSummaryMedia)}
          pagination={page.value.pagination}
          page={1}
          query={{ q, category, tag, sort }}
          route={{
            index: '/resources/',
            pagePattern: '/resources/page/{page}/',
            carry: ['q', 'category', 'tag', 'sort'],
          }}
          emptyText={filtered ? copy.resources.categoryEmpty : copy.resources.listEmpty}
          errorText={copy.state.backendMessage}
          locale={page.locale}
        />
      </>
    )
  }
</AppShell>
