---
/**
 * Reserved 404 route: every unmatched URL lands here (dev + SSR). The shell
 * renders normally — the backend is up, the URL is just unknown — with a
 * real 404 status and a noindex.
 */
import AppShell from '@/components/layout/AppShell.astro';
import PageState from '@/components/layout/PageState.astro';
import { t } from '@/lib/i18n';
import { loadPage } from '@/lib/page.server';

const page = await loadPage(async () => undefined, Astro.cookies);
Astro.response.status = 404;
const copy = t(page.locale);
---

<AppShell
  page={page}
  title={copy.state.notFoundPageTitle}
  description={copy.state.notFoundPageMessage}
  noindex
>
  {
    page.ok && (
      <PageState
        image={page.site.defaults.emptyImage}
        title={copy.state.notFoundPageTitle}
        message={copy.state.notFoundMessage}
        retry="/"
        retryLabel={copy.common.backHome}
      />
    )
  }
</AppShell>
