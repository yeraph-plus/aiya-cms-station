---
/** Page list pagination: /pages/page/[n]/ (n ≥ 2). */
import AppShell from '@/components/layout/AppShell.astro';
import PageState from '@/components/layout/PageState.astro';
import PostLoop from '@/components/islands/feed/PostLoop';
import { cloakPostSummaryMedia } from '@/lib/media';
import { t } from '@/lib/i18n';
import { loadPage } from '@/lib/page.server';
import { setCrumbs } from '@/lib/breadcrumbs';

const n = Number(Astro.params.n);
// Page 1 and non-numeric shapes live at /pages/ — permanent
// normalization (308), and the active filter query rides along.
if (!Number.isInteger(n) || n < 2) {
  return Astro.redirect(`/pages/${Astro.url.search}`, 308);
}

// Same filter contract as /pages/ — q / category / sort (pages have no tag
// vocabulary). Page 1 and its paginated pages must read the identical keys,
// or a filter set on page 1 silently vanishes on page 2.
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
const category = (Astro.url.searchParams.get('category') ?? '').slice(0, 200);
const sort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
const filtered = q !== '' || category !== '';

const page = await loadPage(
  async (client) => {
    const list = await client.pages({ page: n, q, category, sort });
    return { pages: list.data.map(cloakPostSummaryMedia), pagination: list.meta.pagination };
  },
  Astro.cookies,
  Astro.locals.visitorIp,
);
if (!page.ok) Astro.response.status = page.error.status;
const overRange = page.ok && n > page.value.pagination.totalPages;
if (overRange) Astro.response.status = 404;
const copy = t(page.locale);
if (page.ok)
  setCrumbs(Astro.locals, page.locale, [
    { label: copy.pages.title, href: '/pages/' },
    { label: copy.pages.pageOf(n) },
  ]);
const showList = page.ok && !overRange;
const title = q !== '' ? copy.posts.searchTitle(q) : copy.pages.pageOf(n);
---

<AppShell
  page={page}
  title={title}
  description={copy.pages.description}
  canonicalPath={`/pages/page/${n}/`}
  noindex={filtered || overRange}
>
  {
    page.ok &&
      (showList ? (
        <>
          <h1 class="sr-only">{title}</h1>
          <PostLoop
            autoLoad
            client:load
            endpoint="/api/feed/pages/"
            items={page.value.pages}
            pagination={page.value.pagination}
            page={n}
            query={{ q, category, sort }}
            route={{
              index: '/pages/',
              pagePattern: '/pages/page/{page}/',
              carry: ['q', 'category', 'sort'],
            }}
            emptyText={copy.pages.listEmpty}
            errorText={copy.state.backendMessage}
            locale={page.locale}
          />
        </>
      ) : (
        <PageState
          image={page.site.defaults.emptyImage}
          error
          title={copy.state.notFoundTitle}
          message={copy.state.notFoundMessage}
          retry="/pages/"
          retryLabel={copy.common.retry}
        />
      ))
  }
</AppShell>
