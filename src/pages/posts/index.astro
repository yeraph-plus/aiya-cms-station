---
import AppShell from '@/components/layout/AppShell.astro';
import PostLoop from '@/components/islands/feed/PostLoop';
import { cloakPostSummaryMedia } from '@/lib/media';
import { iconInner } from '@/lib/icons';
import { t } from '@/lib/i18n';
import { loadPage } from '@/lib/page.server';
import { setCrumbs } from '@/lib/breadcrumbs';

// The posts list filter contract — q / category / tag / sort. Both this route
// and /posts/page/[n]/ read the same four keys and pass the same carry list,
// so paginating never silently drops a filter.
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
const category = (Astro.url.searchParams.get('category') ?? '').slice(0, 200);
const tag = (Astro.url.searchParams.get('tag') ?? '').slice(0, 200);
const sort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
const page = await loadPage(
  async (client) => {
    const [posts, terms, tagTerms] = await Promise.all([
      client.posts({ q, category, tag, sort }),
      client.terms('category', 'post'),
      client.terms('tag', 'post'),
    ]);
    return {
      posts: posts.data,
      pagination: posts.meta.pagination,
      categories: terms.data.filter((term) => term.taxonomy === 'category'),
      tags: tagTerms.data.filter((term) => term.taxonomy === 'tag'),
    };
  },
  Astro.cookies,
  Astro.locals.visitorIp,
);
if (!page.ok) Astro.response.status = page.error.status;
const copy = t(page.locale);
if (page.ok) setCrumbs(Astro.locals, page.locale, [{ label: copy.posts.title }]);
const filtered = q !== '' || category !== '' || tag !== '';
const listTitle = q !== '' ? copy.posts.searchTitle(q) : copy.posts.title;
// Category chips filter this same list, so their crawlable fallback href is
// the query state the island itself produces — the path route they used to
// point at (/posts/category/{slug}/) no longer exists. The crawlable category
// archive is /categories/{slug}/ and is linked from the category index.
const chips = [
  {
    slug: '',
    name: copy.posts.all,
    href: '/posts/',
    route: {
      index: '/posts/',
      pagePattern: '/posts/page/{page}/',
      carry: ['q', 'category', 'tag', 'sort'],
    },
  },
  ...(page.ok
    ? page.value.categories.map((term) => ({
        slug: term.slug,
        name: term.name,
        icon: term.icon ? iconInner(term.icon) : null,
        href: `/posts/?category=${encodeURIComponent(term.slug)}`,
      }))
    : []),
];
// One flat tag group for the collapsible filter panel (posts carry a single
// tag vocabulary, so no group headings render).
const tagGroups = page.ok
  ? [
      {
        key: 'post_tag',
        label: copy.posts.tags,
        items: page.value.tags.map((term) => ({
          slug: term.slug,
          name: term.name,
          icon: term.icon ? iconInner(term.icon) : null,
        })),
      },
    ]
  : [];
// Filters (not the sort preference) make the canonical; a filtered list stays
// noindex and defers to the crawlable archive.
const canonicalParams = new URLSearchParams();
if (q !== '') canonicalParams.set('q', q);
if (category !== '') canonicalParams.set('category', category);
if (tag !== '') canonicalParams.set('tag', tag);
const canonicalQuery = canonicalParams.toString();
---

<AppShell
  page={page}
  title={listTitle}
  description={page.site.description}
  canonicalPath={filtered ? `/posts/?${canonicalQuery}` : '/posts/'}
  noindex={filtered || !page.ok}
>
  <h1 class="sr-only">{listTitle}</h1>
  {
    page.ok && (
      <>
        <PostLoop
          autoLoad
          client:load
          chips={chips}
          filterAriaLabel={copy.posts.category}
          tagGroups={tagGroups}
          endpoint="/api/feed/posts/"
          items={page.value.posts.map(cloakPostSummaryMedia)}
          pagination={page.value.pagination}
          page={1}
          query={{ q, category, tag, sort }}
          route={{
            index: '/posts/',
            pagePattern: '/posts/page/{page}/',
            carry: ['q', 'category', 'tag', 'sort'],
          }}
          emptyText={copy.posts.listEmpty}
          errorText={copy.state.backendMessage}
          locale={page.locale}
        />
      </>
    )
  }
</AppShell>
