---
import CommunityBoardPage from '@/components/content/CommunityBoardPage.astro';
import { loadCommunityBoard } from '@/lib/community-board';

const slug = Astro.params.slug ?? '';
const n = Number(Astro.params.n);
// Page 1 lives at the board root; anything non-numeric 308s there (query rides along).
if (!Number.isInteger(n) || n < 2) {
  // Astro params arrive decoded; re-encode the segment (a raw CJK slug
  // would break the Location header).
  return Astro.redirect(`/community/board/${encodeURIComponent(slug)}/${Astro.url.search}`, 308);
}
const view = await loadCommunityBoard(Astro.response, Astro.url, Astro.cookies, Astro.locals, {
  boardSlug: slug,
  page: n,
});
---

<CommunityBoardPage view={view} />
