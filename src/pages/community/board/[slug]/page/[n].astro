---
import CommunityBoardPage from '@/components/content/CommunityBoardPage.astro';
import { loadCommunityBoard } from '@/lib/community-board';

const slug = Astro.params.slug ?? '';
const n = Number(Astro.params.n);
// Page 1 lives at the board root; anything non-numeric 404s.
if (!Number.isInteger(n) || n < 2) {
  return Astro.redirect(`/community/board/${slug}/`);
}
const view = await loadCommunityBoard(Astro.response, Astro.url, Astro.cookies, Astro.locals, {
  boardSlug: slug,
  page: n,
});
---

<CommunityBoardPage view={view} />
