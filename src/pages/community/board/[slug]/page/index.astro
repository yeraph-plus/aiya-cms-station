---
// Page-number-less shape: bounce to the board root ('page' guard as above).
const slug = Astro.params.slug ?? '';
// Astro params arrive decoded; re-encode the segment (a raw CJK slug
// would break the Location header).
return Astro.redirect(
  slug === 'page' ? '/community/' : `/community/board/${encodeURIComponent(slug)}/`,
);
---
