---
// Page-number-less shape: bounce to the search root. Every paged route
// keeps one of these fallbacks except this one, which was missing.
import { searchPath } from '@/lib/search';

const key = Array.isArray(Astro.params.key) ? Astro.params.key[0] : (Astro.params.key ?? '');
return Astro.redirect(key === '' ? '/' : searchPath(key));
---
