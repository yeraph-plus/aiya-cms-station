---
import { ClientRouter } from 'astro:transitions';
import type { Site } from '@/lib/core/contracts';
import { rewriteMediaUrl } from '@/lib/media';
import { serializeJsonLd } from '@/lib/seo';
interface Props {
  /** Page title; empty on the homepage (bare site name, no suffix). */
  title: string;
  description: string;
  site: Site;
  /** Absolute http(s) origin, from siteOrigin(). */
  origin: string;
  canonicalPath?: string;
  noindex?: boolean;
  /** Image URL for og:image / twitter:image (e.g. the post thumbnail);
      relative /media/ paths are absolutized against the site origin. */
  image?: string | null;
  /** Open Graph type: 'article' on post/page/resource details. */
  ogType?: 'website' | 'article';
  /** JSON-LD objects from lib/seo; serialized inline. */
  jsonLd?: object[];
}
const {
  title,
  description,
  site,
  origin,
  canonicalPath,
  noindex = false,
  image = null,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;
// Degraded shells resolve origin to '' (AIYA_SITE_URL failed validation):
// they are noindex anyway, so canonical/og:url are dropped instead of
// throwing `new URL(path, '')` at render time.
const hasOrigin = origin !== '';
const canonical =
  canonicalPath !== undefined && hasOrigin ? new URL(canonicalPath, origin).href : null;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
// Home passes an empty title: the document is just the site name.
const fullTitle = title === '' ? site.name : `${title} · ${site.name}`;
// og/twitter images may be local proxy paths; scrapers need them absolute.
const imageUrl =
  image !== null && image.startsWith('/') && hasOrigin ? new URL(image, origin).href : image;
// The WP site icon wins; the bundled favicon is the fallback.
const faviconHref = site.favicon ? rewriteMediaUrl(site.favicon.url) : '/favicon.svg';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{
  // One site-level keyword line (owner-configured in /site); per-page
  // keywords are deliberately not a thing — modern engines ignore them.
  site.defaults.seoKeywords !== '' && (
    <meta name="keywords" content={site.defaults.seoKeywords} />
  )
}
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}
{/* No type attribute on the icon: the WP site icon may be png/jpg, and a
    wrong type hint makes some browsers skip the candidate. HTML comments
    here would ship in the page payload; this form does not. */}
<link rel="icon" href={faviconHref} />
<ClientRouter />
{
  /* Color mode pre-paint: stored choice → site default → system. Runs
    before first paint and again after every ClientRouter swap (the html
    element is replaced by the swap, losing the class). */
}
<script is:inline data-astro-rerun>
  (() => {
    const stored = localStorage.getItem('aiya-color-mode');
    const fallback = document.documentElement.dataset.colorModeDefault;
    const mode =
      stored === 'dark' || stored === 'light'
        ? stored
        : fallback === 'dark' || fallback === 'light'
          ? fallback
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
    document.documentElement.classList.toggle('dark', mode === 'dark');
  })();
</script>
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
{canonical && <meta property="og:url" content={canonical} />}
<!-- og:locale describes the served content language (site setting), not
     the viewer's resolved UI locale — the same URL serves one language. -->
<meta property="og:locale" content={site.language} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{
  jsonLd.map((data) => (
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
  ))
}
{
  /* GA4: the backend carries only the measurement id (G-…); the front end
    assembles the standard gtag.js pair. Skipped in dev so local traffic
    never pollutes analytics. */
}
{
  site.defaults.gaId !== '' && import.meta.env.PROD && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${site.defaults.gaId}`}
      />
      {/* prettier-ignore — the astro plugin cannot parse `arguments` inside
          an inline script and hard-errors the whole check */}
      {/* The measurement id rides on a data attribute instead of
          `define:vars`: the CSP hash is taken over the script body, so a
          per-site value inlined into the body would make the hash change
          with the setting. `document.currentScript` resolves here because
          this is a classic inline script, not a module. */}
      <script is:inline data-ga-id={site.defaults.gaId}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', document.currentScript.dataset.gaId);
      </script>
    </>
  )
}
