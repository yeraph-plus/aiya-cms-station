---
import UserCenter from '@/components/islands/UserCenter';
import SearchBox from '@/components/islands/SearchBox';
import type { UserCenterCopy, UserCenterUser } from '@/components/islands/user-center/types';
import Icon from '@/components/layout/Icon.astro';
import { isSearchScope, normalizeKeyword } from '@/lib/search';
import type { Locale } from '@/lib/i18n/locale';

interface Props {
  menuToggleLabel: string;
  /** Aria/title copy for the color mode toggle (header-owned, not user center). */
  colorModeLabel: string;
  registrationOpen: boolean;
  /** BCP 47 tag forwarded to the notification bubble for date formatting. */
  localeTag: string;
  /** The search island imports its own copy, so it needs the locale. */
  locale: Locale;
  /** Site calendar timezone (from /site) forwarded to the wallet bubble. */
  timezone?: string;
  user: UserCenterUser | null;
  authCopy: UserCenterCopy;
}
const {
  menuToggleLabel,
  colorModeLabel,
  registrationOpen,
  localeTag,
  locale,
  timezone,
  user,
  authCopy,
} = Astro.props;

// The search box mirrors the results already on screen: on /search/{key}/
// it seeds keyword and scope straight from the address bar, so the SSR
// markup is correct and nothing has to be filled in after hydration.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const routedKey = segments[0] === 'search' && segments[1] ? segments[1] : '';
const decodedKey = (() => {
  try {
    return decodeURIComponent(routedKey);
  } catch {
    return '';
  }
})();
const scopeParam = Astro.url.searchParams.get('type') ?? '';
---

<header
  data-shell-header
  class="relative z-30 flex h-12 shrink-0 items-center gap-2 px-3 max-[991px]:hidden"
>
  <button
    type="button"
    data-sidebar-toggle
    aria-label={menuToggleLabel}
    aria-controls="global-sidebar"
    class="flex size-8 shrink-0 items-center justify-center rounded-md text-foreground hover:bg-secondary focus-visible:outline-2 focus-visible:outline-focus-blue"
  >
    <Icon name="menu" size={18} />
  </button>
  <SearchBox
    client:load
    locale={locale}
    value={normalizeKeyword(decodedKey)}
    scope={isSearchScope(scopeParam) ? scopeParam : 'all'}
  />
  <div class="ml-auto flex shrink-0 items-center gap-1.5">
    <button
      type="button"
      data-color-toggle
      aria-label={colorModeLabel}
      title={colorModeLabel}
      class="flex size-8 items-center justify-center rounded-md text-foreground hover:bg-secondary focus-visible:outline-2 focus-visible:outline-focus-blue"
    >
      <Icon name="moon" size={18} class="dark:hidden" />
      <Icon name="sun" size={18} class="hidden dark:block" />
    </button>
    <UserCenter
      client:load
      user={user}
      registrationOpen={registrationOpen}
      localeTag={localeTag}
      locale={locale}
      timezone={timezone}
      copy={authCopy}
    />
  </div>
</header>
