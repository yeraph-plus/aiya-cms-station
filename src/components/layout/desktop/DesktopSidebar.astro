---
import Icon from '@/components/layout/Icon.astro';
import type { MenuItem, Site } from '@/lib/core/contracts';
import { menuIconName } from '@/lib/icons';
import { rewriteMediaUrl, safeHref } from '@/lib/media';
import { isExternalLink, isMenuActive, MENU_LINK_CLASS, MENU_SUBLINK_COMPACT } from '@/lib/menu';

interface Props {
  site: Site;
  menu: MenuItem[];
  pathname: string;
}
const { site, menu, pathname } = Astro.props;

// Active state, external test and row recipes are shared with the mobile
// shells through lib/menu.
const isActive = (url: string) => isMenuActive(pathname, url);
const isExternal = isExternalLink;
const linkClass = MENU_LINK_CLASS;
const subLinkClass = MENU_SUBLINK_COMPACT;
---

<aside
  id="global-sidebar"
  data-scroll-region
  class="group sticky top-0 hidden h-dvh w-[190px] shrink-0 flex-col overflow-y-auto border-r border-sidebar-border bg-surface px-3 py-5 min-[992px]:flex data-[collapsed]:w-[76px]"
>
  <div class="mb-6">
    <a
      href="/"
      title={site.name}
      class="flex h-10 items-center gap-2 whitespace-nowrap px-2 text-primary transition-[padding] duration-200 group-data-[collapsed]:justify-center group-data-[collapsed]:px-0"
    >
      {
        site.favicon ? (
          <img
            src={rewriteMediaUrl(site.favicon.url)}
            alt=""
            class="h-9 w-9 shrink-0 rounded-md"
            width={36}
            height={36}
          />
        ) : null
      }
      <span
        class="brand-title min-w-0 overflow-hidden font-display text-xl font-extrabold leading-none tracking-[-0.06em] group-data-[collapsed]:hidden"
      >
        {site.name.toLowerCase()}
      </span>
    </a>
    <p
      class="brand-desc mt-1 h-4 overflow-hidden px-2 text-[11px] font-bold leading-4 text-body-muted"
    >
      {site.description}
    </p>
  </div>

  <nav aria-label={site.name} class="flex-1">
    <ul class="flex flex-col">
      {
        menu.map((item) =>
          item.children.length > 0 ? (
            <li>
              <details open={isActive(item.url)} class="group/details">
                <summary
                  class:list={[
                    linkClass,
                    'cursor-pointer list-none [&::-webkit-details-marker]:hidden',
                  ]}
                  title={item.label}
                >
                  <Icon name={menuIconName(item)} size={20} strokeWidth={1.8} />
                  <span class="sidebar-collapse-hide">{item.label}</span>
                  <Icon
                    name="chevronRight"
                    size={16}
                    strokeWidth={1.8}
                    class="ml-auto transition-transform duration-200 group-open/details:rotate-90"
                  />
                </summary>
                <ul class="flex flex-col pl-4">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={safeHref(child.url) ?? undefined}
                        aria-current={isActive(child.url) ? 'page' : undefined}
                        class:list={[
                          subLinkClass,
                          isActive(child.url)
                            ? 'bg-secondary font-semibold text-primary'
                            : 'text-body-muted',
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={safeHref(item.url) ?? undefined}
                title={item.label}
                aria-current={isActive(item.url) ? 'page' : undefined}
                target={isExternal(item.url) ? '_blank' : undefined}
                rel={isExternal(item.url) ? 'noreferrer' : undefined}
                class:list={[
                  linkClass,
                  isActive(item.url)
                    ? 'bg-secondary font-semibold text-primary'
                    : 'text-foreground',
                ]}
              >
                <Icon name={menuIconName(item)} size={20} strokeWidth={1.8} />
                <span class="sidebar-collapse-hide">{item.label}</span>
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>
</aside>

<script>
  // Sidebar collapse: the hamburger button in the header is the only control.
  // Collapse hides labels instantly; expand reveals them clipped by the
  // sidebar's overflow hidden (no squeezed text). State survives SPA swaps
  // via localStorage + re-apply on astro:after-swap.
  const STORAGE_KEY = 'aiya-sidebar-collapsed';
  const apply = () => {
    document
      .getElementById('global-sidebar')
      ?.toggleAttribute('data-collapsed', localStorage.getItem(STORAGE_KEY) === '1');
  };
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (!event.target.closest('[data-sidebar-toggle]')) return;
    const sidebar = document.getElementById('global-sidebar');
    if (!sidebar) return;
    const collapsed = !sidebar.hasAttribute('data-collapsed');
    sidebar.toggleAttribute('data-collapsed', collapsed);
    localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
  });
  document.addEventListener('astro:after-swap', apply);
  apply();
</script>
