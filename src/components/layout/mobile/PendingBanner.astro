---
import Icon from '@/components/layout/Icon.astro';

interface Props {
  text: string;
}
const { text } = Astro.props;
---

<p
  class="min-[992px]:hidden flex items-start gap-2 border-b border-primary/20 bg-accent px-4 py-2.5 text-xs leading-relaxed text-foreground"
  role="status"
>
  <Icon name="info" size={14} class="mt-0.5 shrink-0 text-primary" />
  <span>{text}</span>
</p>
