---
import Icon from '@/components/layout/Icon.astro';
import type { Menu } from '@/lib/core/contracts';
import { menuIconName } from '@/lib/icons';
import { safeHref } from '@/lib/media';
import { t, type Locale } from '@/lib/i18n';
import { isExternalLink, isMenuActive } from '@/lib/menu';

interface Props {
  menu: Menu;
  pathname: string;
  locale: Locale;
}
const { menu, pathname, locale } = Astro.props;
const copy = t(locale);
/**
 * The bottom bar (mobile only, UX.md §6): five slots — the first four menu
 * items plus a "more" button that opens the full-menu drawer. With five or
 * fewer items everything fits, so the drawer slot disappears. Icons mirror
 * the desktop sidebar through the shared menuIconName resolver.
 */
const items = menu.items;
const more = items.length > 5;
const visible = more ? items.slice(0, 4) : items.slice(0, 5);
const isActive = (url: string) => isMenuActive(pathname, url);
const isExternal = isExternalLink;
---

<nav
  aria-label="mobile"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-surface pb-[env(safe-area-inset-bottom)] min-[992px]:hidden"
>
  <ul class="grid grid-cols-5">
    {
      visible.map((item) => (
        <li>
          <a
            href={safeHref(item.url) ?? undefined}
            aria-current={isActive(item.url) ? 'page' : undefined}
            target={isExternal(item.url) ? '_blank' : undefined}
            rel={isExternal(item.url) ? 'noreferrer' : undefined}
            class:list={[
              'flex min-h-[56px] flex-col items-center justify-center gap-0.5 px-1 py-2 text-xs focus-visible:outline-2 focus-visible:outline-focus-blue',
              isActive(item.url)
                ? 'font-medium text-primary'
                : 'text-body-muted hover:text-foreground',
            ]}
          >
            <Icon name={menuIconName(item)} size={20} strokeWidth={1.8} />
            <span class="w-full truncate text-center leading-tight">{item.label}</span>
          </a>
        </li>
      ))
    }
    {
      more && (
        <li>
          <button
            type="button"
            data-drawer-toggle
            aria-controls="mobile-menu-drawer"
            aria-expanded="false"
            class="flex min-h-[56px] w-full flex-col items-center justify-center gap-0.5 px-1 py-2 text-xs text-body-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-focus-blue"
          >
            <Icon name="menu" size={20} strokeWidth={1.8} />
            <span class="leading-tight">{copy.shell.mobileMore}</span>
          </button>
        </li>
      )
    }
  </ul>
</nav>
