---
/**
 * @pending 992px 以下移动端壳——待就绪：当前只迭代桌面布局，移动端仅保证可用性并显示提示条。
 */
import type { Menu } from '@/lib/core/contracts';
interface Props {
  menu: Menu;
  pathname: string;
}
const { menu, pathname } = Astro.props;
/** The bottom five-item bar from the layout contract (mobile only). */
const items = menu.items.slice(0, 5);
const isActive = (url: string) => (url === '/' ? pathname === '/' : pathname.startsWith(url));
---

<nav
  aria-label="mobile"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t border-border bg-surface min-[992px]:hidden"
>
  {
    items.map((item) => (
      <a
        href={item.url}
        aria-current={isActive(item.url) ? 'page' : undefined}
        class:list={[
          'flex items-center justify-center py-3 text-xs',
          isActive(item.url) ? 'font-medium text-primary' : 'text-body-muted',
        ]}
      >
        {item.label}
      </a>
    ))
  }
</nav>
