---
import UserCenter from '@/components/islands/UserCenter';
import { NotificationPopover } from '@/components/islands/user-center/NotificationPopover';
import MobileSearch from '@/components/islands/MobileSearch';
import type { UserCenterCopy, UserCenterUser } from '@/components/islands/user-center/types';
import type { Site } from '@/lib/core/contracts';
import { searchSeed } from '@/lib/search';
import { rewriteMediaUrl } from '@/lib/media';
import type { Locale } from '@/lib/i18n';

interface Props {
  site: Site;
  user: UserCenterUser | null;
  authCopy: UserCenterCopy;
  registrationOpen: boolean;
  /** BCP 47 tag for notification date formatting. */
  localeTag: string;
  /** The search island imports its own copy, so it needs the locale. */
  locale: Locale;
  /** Site calendar timezone (from /site) forwarded to the wallet bubble. */
  timezone?: string;
}
const { site, user, authCopy, registrationOpen, localeTag, locale, timezone } = Astro.props;
const siteName = site.name;

// On results pages the search dialog seeds itself from the address bar,
// mirroring the desktop SearchBox (shared rule in lib/search).
const seed = searchSeed(Astro.url.pathname, Astro.url.searchParams.get('type') ?? '');
---

<header class="sticky top-0 z-30 border-b border-border bg-surface min-[992px]:hidden">
  <div class="flex h-14 items-center justify-between gap-2 px-4">
    <a
      href="/"
      title={siteName}
      class="flex min-w-0 items-center gap-2 rounded-md focus-visible:outline-2 focus-visible:outline-focus-blue"
    >
      {
        site.favicon ? (
          <img
            src={rewriteMediaUrl(site.favicon.url)}
            alt=""
            class="size-8 shrink-0 rounded-md"
            width={32}
            height={32}
          />
        ) : null
      }
      <span
        class="min-w-0 truncate font-display text-lg font-semibold tracking-tight text-foreground"
      >
        {siteName}
      </span>
    </a>
    <div class="flex shrink-0 items-center">
      <MobileSearch client:load locale={locale} value={seed.keyword} scope={seed.scope} />
      <NotificationPopover client:load copy={authCopy} localeTag={localeTag} timezone={timezone} />
      <UserCenter
        client:load
        variant="mobile"
        user={user}
        registrationOpen={registrationOpen}
        copy={authCopy}
        localeTag={localeTag}
        locale={locale}
        timezone={timezone}
      />
    </div>
  </div>
</header>
