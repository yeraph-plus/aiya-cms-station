---
import Icon from '@/components/layout/Icon.astro';
import type { MenuItem } from '@/lib/core/contracts';
import { menuIconName } from '@/lib/icons';
import { safeHref } from '@/lib/media';

interface Props {
  siteName: string;
  menu: MenuItem[];
  pathname: string;
}
const { siteName, menu, pathname } = Astro.props;

const isActive = (url: string) => (url === '/' ? pathname === '/' : pathname.startsWith(url));
const isExternal = (url: string) => /^https?:\/\//i.test(url);

// Row proportions mirror the desktop sidebar (44px rows, 14px text) so the
// full menu tree reads the same in both shells.
const linkClass =
  'my-0.5 flex min-h-[44px] items-center gap-3.5 rounded-md px-3.5 py-3 text-sm transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-focus-blue';
const subLinkClass =
  'flex min-h-[44px] items-center rounded-md px-3 py-2 text-sm transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-focus-blue';
---

<!-- Mobile menu drawer (UX.md §6): the TabBar "more" button toggles the full
    primary tree in a left slide-in panel that slides out from UNDER the top
    bar — its z-order sits below the header (z-20 overlay / z-25 panel vs
    the bar's z-30), so the bar keeps floating above it and the panel
    carries no site-name header of its own (content clears the bar with
    extra top padding). Non-modal — the overlay click, Escape and route
    changes all close it (the toggle flips it back too). Closed state is
    inert so nothing inside can be tabbed into; the root's data-open drives
    both panels through the group variant. Desktop shells never render it
    visible. -->
<div id="mobile-menu-drawer-root" class="group min-[992px]:hidden">
  <div
    id="mobile-menu-drawer-overlay"
    data-drawer-overlay
    inert
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-20 bg-scrim-modal opacity-0 transition-opacity duration-200 group-data-[open]:pointer-events-auto group-data-[open]:opacity-100"
  >
  </div>
  <aside
    id="mobile-menu-drawer"
    inert
    tabindex="-1"
    aria-label={siteName}
    class="fixed inset-y-0 left-0 z-[25] flex w-[280px] max-w-[85vw] -translate-x-full flex-col border-r border-border bg-surface pt-[4.5rem] transition-transform duration-200 group-data-[open]:translate-x-0"
  >
    <nav aria-label={siteName} class="flex-1 overflow-y-auto px-3 pb-4">
      <ul class="flex flex-col">
        {
          menu.map((item) =>
            item.children.length > 0 ? (
              <li>
                <details open={isActive(item.url)} class="group/details">
                  <summary
                    class:list={[
                      linkClass,
                      'cursor-pointer list-none pr-12 [&::-webkit-details-marker]:hidden',
                    ]}
                  >
                    <Icon name={menuIconName(item)} size={20} strokeWidth={1.8} />
                    <span>{item.label}</span>
                    <Icon
                      name="chevronRight"
                      size={16}
                      strokeWidth={1.8}
                      class="ml-auto transition-transform duration-200 group-open/details:rotate-90"
                    />
                  </summary>
                  <ul class="flex flex-col pl-4">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={safeHref(child.url) ?? undefined}
                          aria-current={isActive(child.url) ? 'page' : undefined}
                          class:list={[
                            subLinkClass,
                            isActive(child.url)
                              ? 'bg-secondary font-semibold text-primary'
                              : 'text-body-muted',
                          ]}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={safeHref(item.url) ?? undefined}
                  title={item.label}
                  aria-current={isActive(item.url) ? 'page' : undefined}
                  target={isExternal(item.url) ? '_blank' : undefined}
                  rel={isExternal(item.url) ? 'noreferrer' : undefined}
                  class:list={[
                    linkClass,
                    'pr-12',
                    isActive(item.url)
                      ? 'bg-secondary font-semibold text-primary'
                      : 'text-foreground',
                  ]}
                >
                  <Icon name={menuIconName(item)} size={20} strokeWidth={1.8} />
                  <span>{item.label}</span>
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </aside>
</div>

<script>
  // Drawer open/close, document-level so it survives ClientRouter swaps.
  // The toggle flips: opening removes inert from both panels and moves
  // focus into the panel; closing restores it to the invoking TabBar
  // button. Route swaps replace the SSR markup, which renders closed —
  // that is the auto-close path.
  const root = () => document.getElementById('mobile-menu-drawer-root');
  const panel = () => document.getElementById('mobile-menu-drawer');
  const overlay = () => document.getElementById('mobile-menu-drawer-overlay');

  const isOpen = () => root()?.hasAttribute('data-open') ?? false;

  const setOpen = (open: boolean) => {
    root()?.toggleAttribute('data-open', open);
    panel()?.toggleAttribute('inert', !open);
    overlay()?.toggleAttribute('inert', !open);
    for (const button of document.querySelectorAll<HTMLElement>('[data-drawer-toggle]')) {
      button.setAttribute('aria-expanded', String(open));
    }
    if (open) panel()?.focus();
    else document.querySelector<HTMLElement>('[data-drawer-toggle]')?.focus();
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-drawer-toggle]')) {
      setOpen(!isOpen());
      return;
    }
    if (
      event.target.closest('[data-drawer-close]') ||
      event.target.closest('[data-drawer-overlay]')
    ) {
      setOpen(false);
      return;
    }
    if (event.target.closest('#mobile-menu-drawer a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) setOpen(false);
  });
</script>
